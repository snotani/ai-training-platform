      "id": 1,
      "title": "Generative AI Literacy",
      "audienceHint": "All roles",
      "phase": "foundations",
      "lessons": [
        {
          "id": "1.1",
          "title": "The AI Shift",
          "status": "published",
          "difficulty": "Beginner",
          "estMinutes": 12,
          "prerequisites": [],
          "objectives": [
            "Explain the four eras of AI and what changed at each step.",
            "Distinguish Traditional ML, Deep Learning, and Generative AI - how each learns, what it outputs, and its trade-offs.",
            "Choose the right approach for a given real-world problem."
          ],
          "interactive": ["Pick the right tool (drag scenarios to ML / DL / GenAI)"],
          "quizCount": 3,
          "portfolioArtifact": null,
          "contentRef": "CURRICULUM.md::Lesson 1.1 - The AI Shift"
        },
        {
          "id": "1.2",
          "title": "LLM Mechanics",
          "status": "published",
          "difficulty": "Beginner",
          "estMinutes": 12,
          "prerequisites": ["1.1"],
          "objectives": [
            "Explain what a token is and how an LLM turns text into tokens.",
            "Describe next-token prediction and why temperature changes answers.",
            "Explain pre-training vs post-training (including RLHF) in plain terms.",
            "Say what billions of parameters means and why scale matters."
          ],
          "interactive": ["Be the model (pick next token + temperature slider)"],
          "quizCount": 3,
          "portfolioArtifact": null,
          "contentRef": "CURRICULUM.md::Lesson 1.2 - LLM Mechanics"
        },
        {
          "id": "1.3",
          "title": "The Boundaries",
          "status": "published",
          "difficulty": "Beginner",
          "estMinutes": 11,
          "prerequisites": ["1.2"],
          "objectives": [
            "Know at a glance what LLMs are great at vs unreliable at - each with an example.",
            "Explain why hallucinations happen (the mechanism, not just the label).",
            "Identify the main limits: hallucination, bias, knowledge cutoff, weak exact math, context limits, slop.",
            "Apply the right mitigation; confidence is not correctness."
          ],
          "interactive": ["Spot the hallucination (flag the fabricated answer)"],
          "quizCount": 3,
          "portfolioArtifact": null,
          "contentRef": "CURRICULUM.md::Lesson 1.3 - The Boundaries"
        },
        {
          "id": "1.4",
          "title": "Lightweight Corporate Guardrails",
          "status": "published",
          "difficulty": "Beginner",
          "estMinutes": 10,
          "prerequisites": [],
          "objectives": [
            "Decide what is safe to put into which AI tool, and why.",
            "Recognize PII and understand where your data can end up.",
            "Apply practical safe patterns: redact, approved tools, data tiers."
          ],
          "interactive": ["Paste or Don't Paste? (two-step decision game)"],
          "quizCount": 3,
          "portfolioArtifact": null,
          "contentRef": "CURRICULUM.md::Lesson 1.4 - Lightweight Corporate Guardrails"
        }
      ],
