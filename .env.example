# Copy to .env and fill in from your Supabase project (Settings > API).
# All learning content works WITHOUT these; they only enable the optional
# gamification (XP, streaks, badges, leaderboards, certificates) + analytics.

# Canonical site URL. Used for auth redirects (magic links, Google OAuth) so
# emails never point at localhost. Set this in production (e.g. Vercel) to your
# deployed domain. Leave empty locally to fall back to the browser origin.
NEXT_PUBLIC_SITE_URL=https://ai.snotani.com

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Used by the analytics ingest route and (later) the admin
# dashboard. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=
