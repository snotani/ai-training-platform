# Copy to .env and fill in from your Supabase project (Settings > API).
# All learning content works WITHOUT these; they only enable the optional
# gamification (XP, streaks, badges, leaderboards, certificates) + analytics.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Used by the analytics ingest route and (later) the admin
# dashboard. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=
